{
  "name": "@encap/okf-format",
  "version": "0.1.0",
  "private": true,
  "description": "Read, validate, and write Open Knowledge Format (OKF) v0.2 bundles. Nothing outside this package parses frontmatter, resolves links, or handles footnotes (AGENTS.md Section 6).",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-schema.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "npm run build && vitest run"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.9.0",
    "vitest": "^4.1.11"
  }
}
