{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ensim.dev/schema/mission.schema.json",
  "title": "Mission",
  "description": "A specific tasking instance that references the organizations, roles, and doctrine process that generated it, plus mission-specific parameters (Section 6/7 of ARCHITECTURE.md).",
  "type": "object",
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/entityId" },
    "name": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["Draft", "Tasked", "Executing", "Complete"]
    },
    "fictionalized": {
      "type": "boolean",
      "description": "Must be true for any scenario grounded in real precedent but not an actual mission — see AGENTS.md classification-boundary rules."
    },
    "precedent": {
      "type": "string",
      "description": "Real-world operation this scenario is doctrinally/geographically modeled on, if any."
    },
    "doctrineProcessId": { "$ref": "common.schema.json#/$defs/entityId" },
    "organizationsInvolved": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/entityId" },
      "minItems": 1
    },
    "rolesInvolved": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/entityId" }
    },
    "route": {
      "type": "object",
      "properties": {
        "origin": { "type": "string" },
        "destination": { "type": "string" },
        "stagingNote": { "type": "string" }
      },
      "required": ["origin", "destination"],
      "additionalProperties": false
    },
    "cargo": {
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "contents": { "type": "string" },
        "bundleCount": {
          "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }]
        }
      },
      "additionalProperties": false
    },
    "patients": {
      "description": "For aeromedical evacuation missions, in place of cargo — see AE Decision/Interaction records for patient precedence (Urgent/Urgent-Surg/Priority/Routine/Convenience) and type (Litter/Ambulatory).",
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "contents": { "type": "string" },
        "count": {
          "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }]
        },
        "litterCount": {
          "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }]
        },
        "ambulatoryCount": {
          "anyOf": [{ "type": "integer", "minimum": 0 }, { "type": "null" }]
        },
        "precedenceMix": { "type": "string" }
      },
      "additionalProperties": false
    },
    "timeline": {
      "description": "Discrete-event steps for the v1 data/process simulation (Section 4a/7 of ARCHITECTURE.md) — not a flown trajectory.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "step": { "type": "integer", "minimum": 1 },
          "description": { "type": "string" },
          "doctrineProcessStep": {
            "description": "stepNumber this corresponds to in the referenced DoctrineProcess, if applicable.",
            "anyOf": [{ "type": "integer" }, { "type": "null" }]
          }
        },
        "required": ["step", "description"],
        "additionalProperties": false
      }
    },
    "doctrineSource": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/doctrineSource" },
      "minItems": 1
    }
  },
  "required": ["id", "name", "status", "fictionalized", "doctrineProcessId", "organizationsInvolved", "timeline", "doctrineSource"],
  "additionalProperties": false
}
